generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum ItemStatus {
  DRAFT
  ACTIVE
  PENDING
  SOLD
  REMOVED
}

enum LockerStatus {
  EMPTY
  OCCUPIED
  LOCKED
  UNLOCKED
  ERROR
  OUT_OF_SERVICE
}

enum OrderStatus {
  HELD
  COMPLETED
  REFUND_REQUESTED
  REFUNDED
  PARTIAL_REFUND
  CANCELLED
}

enum WalletTxnType {
  TOP_UP
  PURCHASE
  HOLD
  RELEASE
  REFUND
  PARTIAL_REFUND
  COMMISSION
  SLOT_RENTAL
  SELLER_PAYOUT
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  APPROVED
  PARTIAL_APPROVED
  DENIED
}

enum RefundPolicy {
  FULL
  PARTIAL
  DENY
}

enum CaptureType {
  PLACEMENT
  RETURN
}

enum AuditType {
  ORDER
  ADMIN
  LOCKER
  IOT
  AUTH
}

enum LockerEventSource {
  ESP32
  ADMIN
  SYSTEM
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  role          Role     @default(BUYER)
  walletBalance Decimal  @default(0) @db.Decimal(10, 2)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         Item[]
  buyerOrders   Order[]             @relation("BuyerOrders")
  sellerOrders  Order[]             @relation("SellerOrders")
  walletTxns    WalletTransaction[]
  buyerRefunds  Refund[]            @relation("BuyerRefunds")
  sellerRefunds Refund[]            @relation("SellerRefunds")
  payments      PaymongoPayment[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model LockerSubscriptionPlan {
  id           String   @id @default(cuid())
  planKey      String   @unique
  name         String
  durationDays Int
  price        Decimal  @db.Decimal(10, 2)
  highlight    Boolean  @default(false)
  createdAt    DateTime @default(now())

  items Item[]

  @@map("locker_subscription_plans")
}

model LockerSlot {
  id        String       @id @default(cuid())
  slotId    String       @unique
  status    LockerStatus @default(EMPTY)
  lastEvent String?
  updatedAt DateTime     @updatedAt

  currentItem Item?
  events      LockerEvent[]
  captures    CameraCapture[]

  @@map("locker_slots")
}

model Item {
  id                 String     @id @default(cuid())
  title              String
  category           String
  condition          String
  price              Decimal    @db.Decimal(10, 2)
  description        String     @db.Text
  imageUrl           String?
  extractedFeatures  Json?
  sellerCode         String?  @unique  // 6-char code used at kiosk to access the assigned slot
  sellerId           String
  seller             User       @relation(fields: [sellerId], references: [id])
  status             ItemStatus @default(DRAFT)
  slotId             String?    @unique
  slot               LockerSlot? @relation(fields: [slotId], references: [slotId])
  subscriptionPlanId String?
  subscriptionPlan   LockerSubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionEndsAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  orders   Order[]
  captures CameraCapture[]

  @@index([sellerId])
  @@index([status])
  @@map("items")
}

model Order {
  id           String      @id @default(cuid())
  itemId       String
  item         Item        @relation(fields: [itemId], references: [id])
  buyerId      String
  buyer        User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId     String
  seller       User        @relation("SellerOrders", fields: [sellerId], references: [id])
  amount       Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(HELD)
  slotId       String
  personalCode String      @unique
  holdEndsAt   DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  refund Refund?
  events OrderEvent[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("orders")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event     String
  actor     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_events")
}

model WalletTransaction {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  type        WalletTxnType
  amount      Decimal       @db.Decimal(10, 2)
  referenceId String?
  description String?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@map("wallet_transactions")
}

model Refund {
  id                  String       @id @default(cuid())
  orderId             String       @unique
  order               Order        @relation(fields: [orderId], references: [id])
  buyerId             String
  buyer               User         @relation("BuyerRefunds", fields: [buyerId], references: [id])
  sellerId            String
  seller              User         @relation("SellerRefunds", fields: [sellerId], references: [id])
  amount              Decimal      @db.Decimal(10, 2)
  policy              RefundPolicy
  buyerRefundAmount   Decimal      @db.Decimal(10, 2)
  sellerFeeAmount     Decimal      @db.Decimal(10, 2)
  status              RefundStatus @default(REQUESTED)
  classificationResult Json?
  adminNotes          String?      @db.Text
  requestedAt         DateTime     @default(now())
  processedAt         DateTime?

  @@index([buyerId])
  @@index([status])
  @@map("refunds")
}

model CameraCapture {
  id                   String      @id @default(cuid())
  slotId               String
  slot                 LockerSlot  @relation(fields: [slotId], references: [slotId])
  itemId               String?
  item                 Item?       @relation(fields: [itemId], references: [id])
  captureType          CaptureType
  imagePath            String
  classificationResult Json?
  createdAt            DateTime    @default(now())

  @@index([slotId])
  @@map("camera_captures")
}

model LockerEvent {
  id        String            @id @default(cuid())
  slotId    String
  slot      LockerSlot        @relation(fields: [slotId], references: [slotId])
  eventType String
  source    LockerEventSource
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([slotId])
  @@map("locker_events")
}

model PaymongoPayment {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  checkoutSessionId String  @unique
  amount           Decimal  @db.Decimal(10, 2)
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  completedAt      DateTime?

  @@index([userId])
  @@map("paymongo_payments")
}

model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_configs")
}

model AuditLog {
  id        String    @id @default(cuid())
  type      AuditType
  actor     String
  entity    String
  action    String
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([type])
  @@map("audit_logs")
}
